# Copia esto a .env y cambia los valores. NUNCA subas .env al repositorio.

# Puerto y entorno
PORT=3000
NODE_ENV=development

# PostgreSQL. La contraseña NO va aquí en el repo, solo en tu .env local.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutricion_especializada
PGUSER=postgres
PGPASSWORD=cambia-esta-contrasena

# El schema donde vive todo el modelo de datos
DB_SCHEMA=pos
DB_MAX_CONEXIONES=10

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# Secreto para firmar los tokens de sesión (minimo 32 caracteres)
# Duracion de la sesion (el token es opaco, no es un JWT)
JWT_EXPIRES_IN=8h

# Proxy inverso delante de la app: 0 = ninguno, 1 = uno (nginx/Cloudflare)
TRUST_PROXY=0

# Techo general de peticiones por IP antes de responder 429
# La suite de integracion hace mas de 300 por corrida: sube esto en
# desarrollo, y en cualquier otro sitio deja el 300 de aqui.
API_MAX_PETICIONES=300

# Intentos de login por IP antes de responder 429
LOGIN_MAX_INTENTOS=10
