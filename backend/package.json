{
  "name": "nutricion-especializada-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST para Nutriucion Especializada: POS, inventario y cartera",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test:api": "node tests/api.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrar": "tsx scripts/migrar.ts",
    "migrar:estado": "tsx scripts/migrar.ts --estado",
    "migrar:seed": "tsx scripts/migrar.ts --seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
