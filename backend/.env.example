# Copia esto a .env y cambia los valores. NUNCA subas .env al repositorio.

# Puerto y entorno
PORT=3000
NODE_ENV=development

# PostgreSQL. La contraseña NO va aquí en el repo, solo en tu .env local.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutricion_especializada
PGUSER=postgres
PGPASSWORD=cambia-esta-contrasena

# El schema donde vive todo el modelo de datos
DB_SCHEMA=pos

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# Secreto para firmar los tokens de sesión (minimo 32 caracteres)
JWT_SECRET=cambia-este-segredo-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
