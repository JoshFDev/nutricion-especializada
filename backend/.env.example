# Copia esto a .env y cambia los valores. NUNCA subas .env al repositorio.

# Puerto y entorno
PORT=3000
NODE_ENV=development

# PostgreSQL. La contraseña NO va aquí en el repo, solo en tu .env local.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nutricion_especializada
PGUSER=postgres
PGPASSWORD=cambia-esta-contrasena

# El schema donde vive todo el modelo de datos
DB_SCHEMA=pos
DB_MAX_CONEXIONES=10

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# Secreto para firmar los tokens de sesión (minimo 32 caracteres)
# Duracion de la sesion (el token es opaco, no es un JWT)
JWT_EXPIRES_IN=8h

# Proxy inverso delante de la app: 0 = ninguno, 1 = uno (nginx/Cloudflare)
TRUST_PROXY=0

# Datos del emisor: salen impresos en el PDF de la nota de remision.
# Solo EMPRESA_NOMBRE es obligatorio; los demas se omiten si van vacios.
EMPRESA_NOMBRE=Nutricion Especializada
EMPRESA_RFC=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=

# Correo electrónico (SMTP) para recuperación de contraseña y notificaciones
# Para Gmail usa puerto 587 con STARTTLS (SMTP_SECURE=false) y una
# contraseña de aplicación (NO la contraseña normal de la cuenta).
# Genera la tuya en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nutrición Especializada <no-reply@localhost>"

# URL base para enlaces del correo (recuperación de contraseña)
APP_URL=http://localhost:4200
