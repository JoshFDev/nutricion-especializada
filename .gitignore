# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
build/
.angular/
out-tsc/
*.tsbuildinfo

# Entorno: NUNCA subir la contraseña de la base de datos
.env
.env.*
!.env.example

# Datos reales de clientes: nunca deben llegar al repositorio
*.sql.gz
*.dump
dump/
backups/
db/data/

# La plantilla real de la nota de remision: trae la direccion y el telefono
# del negocio. Lo que se versiona es `nota-remision.example.xlsx`.
backend/plantillas/nota-remision.xlsx

# La plantilla de estado de cuenta por cliente: se llena con el saldo real de
# cada cliente y no se versiona. Ver `nota-remision.example.xlsx` para el molde.
backend/plantillas/EstadoCuentaCliente.xlsx

# La letra del papel, por la misma razon: Bahnschrift y Arial Black son de
# Microsoft y no se pueden redistribuir. Si dejas aqui un `.ttf` de la variante
# condensada, el PDF deja de dibujar con Helvetica y sale con la misma letra
# que el Excel. Sin el, tambien funciona, solo que las letras tienen otra forma.
backend/plantillas/papel*.ttf

# Logs y temporales
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.DS_Store
Thumbs.db
