{
  "name": "nutricion-especializada-desktop",
  "version": "1.0.0",
  "description": "Nutricion Especializada - Version escritorio",
  "main": "dist-electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron-vite dev",
    "compilar": "tsc -p tsconfig.json",
    "recursos": "node scripts/preparar-backend.mjs",
    "empaquetar": "electron-builder",
    "build": "pnpm build:backend && pnpm build:frontend && pnpm compilar && pnpm recursos && pnpm empaquetar",
    "build:dir": "pnpm build:backend && pnpm build:frontend && pnpm compilar && pnpm recursos && pnpm empaquetar --dir",
    "build:backend": "pnpm --dir ../backend build",
    "build:frontend": "pnpm --dir ../frontend build --configuration desktop",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-updater": "^6.6.2",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3"
  }
}
